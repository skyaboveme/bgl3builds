---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { process, services, site } from "../data/site";
import { projects } from "../data/projects";

const featuredServices = services.slice(0, 8);
const hero = projects[0];
---

<Base overlayHeader>
  <section class="relative min-h-[100svh] overflow-hidden bg-ink text-sand">
    {
      hero && (
        <Image
          src={hero.image}
          alt="Waterfront deck with black railings overlooking a canal and custom home"
          class="absolute inset-0 h-full w-full object-cover"
          widths={[720, 1200, 1920]}
          sizes="100vw"
          priority
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/75 to-ink/20"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-ink/30"></div>

    <div class="relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-32 md:px-8 md:pb-20">
      <p class="text-[0.7rem] font-semibold tracking-[0.28em] text-teal-bright uppercase">
        45 years on the tools
      </p>
      <h1 class="display mt-4 max-w-3xl text-5xl leading-[1.05] md:text-7xl">
        {site.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-sand/78 md:text-lg">
        Custom homes, remodels, decks, docks, cabinets, and finish work — built from the blueprints, with the kind of customer service people call back for.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex rounded-full bg-teal-bright px-6 py-3 text-sm font-semibold text-ink"
        >
          Start a project
        </a>
        <a
          href="/work"
          class="inline-flex rounded-full border border-sand/30 px-6 py-3 text-sm font-semibold text-sand"
        >
          See the work
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-sand">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 md:grid-cols-3 md:px-8 md:py-12">
      <div>
        <p class="display text-4xl text-teal">45</p>
        <p class="mt-1 text-sm font-semibold">Years of jobsite experience</p>
        <p class="mt-1 text-sm text-muted">Residential and commercial — not a first-year crew.</p>
      </div>
      <div>
        <p class="display text-4xl text-teal">Print</p>
        <p class="mt-1 text-sm font-semibold">We read the drawings</p>
        <p class="mt-1 text-sm text-muted">Blueprints, details, and notes get followed, not guessed.</p>
      </div>
      <div>
        <p class="display text-4xl text-teal">Call</p>
        <p class="mt-1 text-sm font-semibold">Customer service that stays</p>
        <p class="mt-1 text-sm text-muted">Clear answers, clean sites, and we do not vanish at punch list.</p>
      </div>
    </div>
  </section>

  <section class="px-5 py-20 md:px-8 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="text-[0.7rem] font-semibold tracking-[0.22em] text-teal uppercase">What we build</p>
          <h2 class="display mt-3 text-4xl leading-tight md:text-5xl">
            From the foundation to the last piece of trim.
          </h2>
        </div>
        <a href="/services" class="text-sm font-semibold text-teal">All services →</a>
      </div>

      <ol class="mt-12 divide-y divide-line border-y border-line">
        {
          featuredServices.map((item, index) => (
            <li>
              <a
                href={`/services#${item.slug}`}
                class="group grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-1 py-6 md:grid-cols-[4rem_1fr_2fr_auto]"
              >
                <span class="text-xs font-semibold tracking-[0.16em] text-muted">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="display text-2xl group-hover:text-teal md:text-[1.7rem]">{item.title}</span>
                <span class="col-span-2 text-sm leading-relaxed text-muted md:col-span-1">
                  {item.short}
                </span>
                <span class="hidden text-sm font-semibold text-teal md:block">View</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-ink px-5 py-20 text-sand md:px-8 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="text-[0.7rem] font-semibold tracking-[0.22em] text-teal-bright uppercase">Selected work</p>
          <h2 class="display mt-3 text-4xl md:text-5xl">Built for weather, use, and the house it belongs to.</h2>
        </div>
        <a href="/work" class="text-sm font-semibold text-teal-bright">Full gallery →</a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-12">
        {
          projects.map((project, index) => (
            <a
              href="/work"
              class:list={[
                "group relative overflow-hidden rounded-2xl",
                index === 0 ? "md:col-span-7 min-h-[22rem]" :
                index === 1 ? "md:col-span-5 min-h-[18rem]" :
                "md:col-span-4 min-h-[16rem]",
              ]}
            >
              <Image
                src={project.image}
                alt={project.title}
                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
                widths={[600, 1000, 1400]}
                sizes="(min-width: 768px) 50vw, 100vw"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/15 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-6">
                <p class="text-[0.68rem] font-semibold tracking-[0.18em] text-teal-bright uppercase">
                  {project.services.join(" · ")}
                </p>
                <h3 class="display mt-2 text-2xl">{project.title}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-5 py-20 md:px-8 md:py-28">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[8rem] leading-none text-teal md:text-[10rem]">45</p>
        <p class="text-[0.7rem] font-semibold tracking-[0.24em] text-muted uppercase">Years of building</p>
      </div>
      <div class="md:col-span-7">
        <h2 class="display text-4xl leading-tight md:text-5xl">A crew that still answers the phone.</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
          BGL3 Builds grew out of decades on commercial jobs, custom homes, and the everyday work that keeps a house livable — fences, doors, cabinets, docks. We take pride in reading the plans, doing the work clean, and treating your property like we will be invited back.
        </p>
        <a href="/about" class="mt-6 inline-flex text-sm font-semibold text-teal">Our story →</a>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-sand px-5 py-20 md:px-8 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="text-[0.7rem] font-semibold tracking-[0.22em] text-teal uppercase">How we work</p>
      <h2 class="display mt-3 text-4xl">Listen. Plan. Build. Stand behind it.</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-4">
        {
          process.map((item) => (
            <div>
              <p class="text-xs font-semibold tracking-[0.18em] text-teal">{item.step}</p>
              <h3 class="display mt-3 text-2xl">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
