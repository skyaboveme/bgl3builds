---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="px-5 pt-40 pb-28 md:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-[0.7rem] font-semibold tracking-[0.22em] text-teal uppercase">404</p>
      <h1 class="display mt-4 text-5xl">That page is not on the drawings.</h1>
      <p class="mt-4 text-muted">The link may be old, or the page never got framed. Head back to the work — or tell us what you need built.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="inline-flex rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-sand">Home</a>
        <a href="/contact" class="inline-flex rounded-full border border-line px-5 py-2.5 text-sm font-semibold">Contact</a>
      </div>
    </div>
  </section>
</Base>
