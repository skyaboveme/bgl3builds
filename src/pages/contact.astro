---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---

<Base title="Contact" description="Start a project with BGL3 Builds — custom homes, remodels, decks, docks, and finish work.">
  <section class="px-5 pt-32 pb-20 md:px-8 md:pt-40 md:pb-28">
    <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="text-[0.7rem] font-semibold tracking-[0.22em] text-teal uppercase">Contact</p>
        <h1 class="display mt-4 text-5xl leading-[1.08] md:text-6xl">Tell us what you need built.</h1>
        <p class="mt-6 text-base leading-relaxed text-muted">
          Share a few details about the property, the drawings, and the timeline. We read every note and get back to you with a clear next step.
        </p>

        <dl class="mt-10 space-y-6">
          <div>
            <dt class="text-[0.68rem] font-semibold tracking-[0.18em] text-teal uppercase">Email</dt>
            <dd class="mt-1">
              <a class="text-lg font-semibold" href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div>
            <dt class="text-[0.68rem] font-semibold tracking-[0.18em] text-teal uppercase">What to include</dt>
            <dd class="mt-1 text-sm leading-relaxed text-muted">
              Address or area, photos if you have them, whether there are blueprints, and when you would like to start.
            </dd>
          </div>
          <div>
            <dt class="text-[0.68rem] font-semibold tracking-[0.18em] text-teal uppercase">How we reply</dt>
            <dd class="mt-1 text-sm leading-relaxed text-muted">
              Promptly, in plain language. No runaround — if we are not the right fit, we will say so.
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-3xl border border-line bg-white p-6 md:col-span-7 md:p-10">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
