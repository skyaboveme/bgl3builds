---
import Logo from "./Logo.astro";
import { nav } from "../data/site";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class:list={[
    "fixed inset-x-0 top-0 z-50 transition-colors duration-300",
    overlay ? "header-overlay" : "bg-paper/92 border-b border-line backdrop-blur-md",
  ]}
  data-overlay={overlay ? "true" : "false"}
>
  <div class="mx-auto flex h-[4.25rem] max-w-6xl items-center justify-between px-5 md:px-8">
    <Logo variant={overlay ? "light" : "dark"} />

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link text-[0.8rem] font-semibold tracking-[0.14em] uppercase transition-colors",
              pathname === item.href || pathname.startsWith(`${item.href}/`)
                ? "is-active"
                : "",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="cta hidden rounded-full px-4 py-2 text-[0.78rem] font-semibold tracking-wide sm:inline-flex"
      >
        Start a project
      </a>
      <button
        id="menu-btn"
        type="button"
        class="menu-btn inline-flex h-10 w-10 items-center justify-center rounded-full md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="sr-only">Menu</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-white/10 bg-ink px-5 py-6 md:hidden">
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-2 py-3 text-sm font-semibold tracking-[0.12em] text-sand uppercase"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="mt-3 inline-flex justify-center rounded-full bg-teal-bright px-4 py-3 text-sm font-semibold text-ink"
      >
        Start a project
      </a>
    </nav>
  </div>
</header>

<style>
  .header-overlay {
    background: transparent;
    border-bottom-color: transparent;
  }

  .header-overlay.scrolled {
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    backdrop-filter: blur(12px);
  }

  .header-overlay .nav-link {
    color: rgb(243 237 227 / 0.82);
  }

  .header-overlay .nav-link:hover,
  .header-overlay .nav-link.is-active {
    color: var(--color-sand);
  }

  .nav-link {
    color: var(--color-muted);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-ink);
  }

  .cta {
    background: var(--color-teal);
    color: white;
  }

  .header-overlay .cta {
    background: var(--color-teal-bright);
    color: var(--color-ink);
  }

  .menu-btn {
    color: inherit;
  }

  .header-overlay .menu-btn {
    color: var(--color-sand);
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    position: relative;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .menu-icon::before {
    top: -6px;
  }

  .menu-icon::after {
    top: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  function onScroll() {
    const header = document.getElementById("site-header");
    if (!header || header.dataset.overlay !== "true") return;
    header.classList.toggle("scrolled", window.scrollY > 24);
  }

  function initHeader() {
    const header = document.getElementById("site-header");
    const button = document.getElementById("menu-btn");
    const panel = document.getElementById("mobile-nav");
    if (!header || !button || !panel) return;

    onScroll();

    button.addEventListener("click", () => {
      const open = panel.classList.toggle("hidden") === false;
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (header.dataset.overlay === "true") {
        header.classList.toggle("scrolled", open || window.scrollY > 24);
      }
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  initHeader();
</script>
